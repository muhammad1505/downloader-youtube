<?xml version="1.0" encoding="utf-8"?>
<!-- Shortcut tahan-ikon launcher. Tujuannya MainActivity yang sama; aksinya dibaca
     AppDestination.fromAction sehingga tidak ada layar kedua dengan state terpisah. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="download"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_download"
        android:shortcutShortLabel="@string/shortcut_download_short"
        android:shortcutLongLabel="@string/shortcut_download_long">
        <intent
            android:action="id.local.tubeflow.action.OPEN_DOWNLOAD"
            android:targetPackage="id.local.tubeflow"
            android:targetClass="id.local.tubeflow.MainActivity" />
        <categories android:name="id.local.tubeflow.shortcut.download" />
    </shortcut>
    <shortcut
        android:shortcutId="audio"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_audio"
        android:shortcutShortLabel="@string/shortcut_audio_short"
        android:shortcutLongLabel="@string/shortcut_audio_long">
        <intent
            android:action="id.local.tubeflow.action.OPEN_AUDIO"
            android:targetPackage="id.local.tubeflow"
            android:targetClass="id.local.tubeflow.MainActivity" />
        <categories android:name="id.local.tubeflow.shortcut.audio" />
    </shortcut>
    <shortcut
        android:shortcutId="video"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_video"
        android:shortcutShortLabel="@string/shortcut_video_short"
        android:shortcutLongLabel="@string/shortcut_video_long">
        <intent
            android:action="id.local.tubeflow.action.OPEN_VIDEO"
            android:targetPackage="id.local.tubeflow"
            android:targetClass="id.local.tubeflow.MainActivity" />
        <categories android:name="id.local.tubeflow.shortcut.video" />
    </shortcut>
    <shortcut
        android:shortcutId="history"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_history"
        android:shortcutShortLabel="@string/shortcut_history_short"
        android:shortcutLongLabel="@string/shortcut_history_long">
        <intent
            android:action="id.local.tubeflow.action.OPEN_HISTORY"
            android:targetPackage="id.local.tubeflow"
            android:targetClass="id.local.tubeflow.MainActivity" />
        <categories android:name="id.local.tubeflow.shortcut.history" />
    </shortcut>
</shortcuts>
